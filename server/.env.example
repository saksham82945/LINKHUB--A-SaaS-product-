# ─── SERVER ───────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ─── DATABASE (PostgreSQL via Supabase) ───────────────
DATABASE_URL="postgresql://postgres:password@localhost:5432/linkport_dev"

# ─── REDIS (Upstash for production / local for dev) ───
REDIS_URL="redis://localhost:6379"

# ─── JWT ──────────────────────────────────────────────
JWT_SECRET="your_super_secret_jwt_key_change_this"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="your_refresh_secret_change_this"
JWT_REFRESH_EXPIRES_IN="7d"

# ─── FRONTEND URL (for CORS + email links) ────────────
CLIENT_URL="http://localhost:3000"

# ─── AWS S3 + CloudFront ──────────────────────────────
AWS_REGION="ap-south-1"
AWS_ACCESS_KEY_ID="your_aws_access_key"
AWS_SECRET_ACCESS_KEY="your_aws_secret_key"
AWS_S3_BUCKET="linkport-media"
AWS_CLOUDFRONT_URL="https://your-cf-id.cloudfront.net"

# ─── OAUTH — LinkedIn ─────────────────────────────────
LINKEDIN_CLIENT_ID="your_linkedin_client_id"
LINKEDIN_CLIENT_SECRET="your_linkedin_client_secret"
LINKEDIN_CALLBACK_URL="http://localhost:5000/oauth/linkedin/callback"

# ─── OAUTH — GitHub ───────────────────────────────────
GITHUB_CLIENT_ID="your_github_client_id"
GITHUB_CLIENT_SECRET="your_github_client_secret"
GITHUB_CALLBACK_URL="http://localhost:5000/oauth/github/callback"

# ─── OAUTH — Twitter/X ────────────────────────────────
TWITTER_CLIENT_ID="your_twitter_client_id"
TWITTER_CLIENT_SECRET="your_twitter_client_secret"
TWITTER_CALLBACK_URL="http://localhost:5000/oauth/twitter/callback"

# ─── OpenAI (GPT-4o) ──────────────────────────────────
OPENAI_API_KEY="sk-your_openai_api_key"
OPENAI_MODEL="gpt-4o"

# ─── Razorpay (India Payments) ────────────────────────
RAZORPAY_KEY_ID="rzp_test_your_key_id"
RAZORPAY_KEY_SECRET="your_razorpay_secret"
RAZORPAY_WEBHOOK_SECRET="your_webhook_secret"

# ─── Stripe (Global Payments) ─────────────────────────
STRIPE_SECRET_KEY="sk_test_your_stripe_key"
STRIPE_WEBHOOK_SECRET="whsec_your_stripe_webhook"

# ─── Email (Resend) ───────────────────────────────────
RESEND_API_KEY="re_your_resend_api_key"
FROM_EMAIL="noreply@linkport.io"
FROM_NAME="LinkPort"

# ─── Encryption (for OAuth token storage) ─────────────
ENCRYPTION_KEY="32_character_hex_key_for_aes256"

# ─── Rate Limiting ────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# ─── MaxMind GeoIP ────────────────────────────────────
MAXMIND_DB_PATH="./geoip/GeoLite2-City.mmdb"

# ─── Scraper / LeetCode + CodeChef ───────────────────
SCRAPER_USER_AGENT="Mozilla/5.0 LinkPort-Bot/1.0"
CACHE_TTL_LEETCODE=86400
CACHE_TTL_CODECHEF=86400
